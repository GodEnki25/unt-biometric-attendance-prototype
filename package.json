{
  "scripts": {
    "backend": "cd backend && .venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "cd react_demo/reactDemo && npx expo start",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run backend\" \"npm run frontend\""
  },

  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
